{
  "version": 1,
  "doc": "The one-shot / staging clip table (s2-view brief 4.1.9, 4.2.13, 4.2.14; ruling L14). Owner s2-view. Read by ClipRules (view), SliceClips (the slice clip manifest) and, through SliceClips, by the content coverage lint, the rig lint A24/A25/A29 and the anim tests. Row fields: key (the map.json key the view selects; '*' = expanded per id), trigger (what the sim or the view does), rig, clip | clips (the default clip ids; a list is picked by the one-shot's variant), layer (base | overlay | fx | none), mask (overlays), len {src: sim:<oneshot id> | clip_timings | squeak_bits | micro_gags | reactions | caught:<phase> | clip, loop_ok, tol_f, max_f}, ends (sim | plays_out | state_change | clip_end | flavour), fallback (the map key tried when the clip is missing; '' = the natural resolution order), frame (oneshot_t = frame-locked to the sim's one-shot clock; view = the view's own clock), then (a clip played after the first one ends), attach (two-rig socket link), fx (a view effect staged with the row), episodes ('all' or ids).",
  "rows": [
    {"key": "bit:*", "trigger": "oneshot bit:<bit_id> (squeak bit, sim bit_until)", "rig": "bellows", "clip": "bellows/{id}", "layer": "base", "len": {"src": "squeak_bits", "tol_f": 2, "loop_ok": false}, "ends": "sim", "fallback": "activity", "frame": "oneshot_t", "episodes": "all"},
    {"key": "bit:bit_livid", "trigger": "the Livid squeak bit ('WHO SQUEAKED?!', activities.json squeak_bits.bit_livid while_tier livid, once per Night) — the sim does not play while_tier bits yet (Bits.on_squeak plays only the current activity's squeak_bit), so it can occur in no Night: set episodes back to 'all' when it does (r3d-integrate request to the sim owner)", "rig": "bellows", "clip": "bellows/bit_livid", "layer": "base", "len": {"src": "squeak_bits", "tol_f": 2, "loop_ok": false}, "ends": "sim", "fallback": "activity", "frame": "oneshot_t", "episodes": []},
    {"key": "oneshot:head_turn", "trigger": "head_turn ('...the pipes?')", "rig": "bellows", "clip": "bellows/st_head_turn", "layer": "overlay", "mask": "head", "len": {"src": "sim:head_turn", "loop_ok": false}, "ends": "sim", "fallback": "", "frame": "oneshot_t", "episodes": "all"},
    {"key": "oneshot:specs_on", "trigger": "specs_on (the 12 ticks after specs {on: true})", "rig": "bellows", "clip": "bellows/st_specs_on", "layer": "overlay", "mask": "upper", "len": {"src": "sim:specs_on", "loop_ok": false}, "ends": "plays_out", "fallback": "", "frame": "oneshot_t", "episodes": "all"},
    {"key": "oneshot:doorway_pause", "trigger": "doorway_pause (no-ambush pause, 90 - eta ticks)", "rig": "bellows", "clip": "bellows/st_straighten_cravat", "layer": "base", "len": {"src": "sim:doorway_pause", "loop_ok": true}, "ends": "sim", "fallback": "", "frame": "oneshot_t", "loop": true, "episodes": "all"},
    {"key": "oneshot:look_back", "trigger": "look_back (Steaming+ doorway)", "rig": "bellows", "clip": "bellows/st_look_back", "layer": "base", "len": {"src": "sim:look_back", "loop_ok": false}, "ends": "sim", "fallback": "", "frame": "oneshot_t", "episodes": "all"},
    {"key": "oneshot:bump", "trigger": "bump (first bump: pat 30, walk-on 40, turn 12)", "rig": "bellows", "clip": "bellows/st_bump", "layer": "base", "len": {"src": "sim:bump", "loop_ok": false}, "ends": "sim", "fallback": "", "frame": "oneshot_t", "episodes": ["n01_throat_tea", "n02_something_fishy"]},
    {"key": "oneshot:bump_look", "trigger": "bump_look (stares at the bumped statue)", "rig": "bellows", "clip": "bellows/st_look", "layer": "base", "len": {"src": "sim:bump_look", "loop_ok": true, "max_f": 180}, "ends": "sim", "fallback": "", "frame": "oneshot_t", "loop": true, "episodes": ["n01_throat_tea", "n02_something_fishy"]},
    {"key": "oneshot:curious_stop", "trigger": "curious_stop (CURIOUS: the '?' starts filling)", "rig": "bellows", "clip": "bellows/st_suspicious", "layer": "base", "len": {"src": "sim:curious_stop", "loop_ok": false}, "ends": "sim", "fallback": "", "frame": "oneshot_t", "episodes": "all"},
