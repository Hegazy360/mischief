{
  "version": 1,
  "schema": "events.<sim event> = action | [action]. action = {sfx: id|[ids], voice: bank, sting: id (Audio.sting), crowd: kind (Audio.crowd), music: state (Audio.music_state), chain: n|'link' (Audio.chain_section, 'link' = payload link clamped 1..4), delay_s (view time: JuiceClock-scaled, a hit-stop holds it), vol_db, pan: 'source'|'hush'|'bellows'|'center' (default source), when: condition id evaluated by the AudioDirector (hush_exposed, hush_in_room, bellows_on_screen, first_in_night), by: {field: payload key, map: {'<value as text>': action|[action]}, default: action}, then: [action]}. pranks.<id>.fire plays on prank_fire (the prop's sound, never his voice); archetypes.<archetype>.ooh=true plays crowd ooh on reaction_start; squeak_bits.<bit> plays on squeak_bit; laugh_tiers picks the laugh from applause deltas (tenths). Ruling L12: this file holds only event-level sounds (stingers, the crowd, music, UI and props the view stages); every sound inside a clip is a clip event (docs/review/s2-sound/clip_events.md) and never also appears here.",
  "events": {
    "rummage": {"by": {"field": "container", "map": {
      "hall_confiscated_box": {"sfx": "cupboard"},
      "kitchen_fridge": {"sfx": "door_back", "vol_db": -4.0},
      "kitchen_pantry_shelf": {"sfx": "cupboard"}}, "default": {"sfx": "cupboard"}}},
    "pick": {"sfx": "zip", "vol_db": -8.0, "pan": "hush"},
    "item_home": {"sfx": "whoosh", "vol_db": -6.0, "pan": "hush"},
    "rig_start": {"by": {"field": "prank", "map": {"achoo_ria": {"sfx": "pepper_shake", "pan": "hush", "vol_db": -4.0}}}},
    "rig_step_done": {"sfx": "rig_done"},
    "rigged": [{"sting": "rigged"}, {"crowd": "t0", "delay_s": 0.35}],
    "hide": {"by": {"field": "watched", "map": {"true": {"crowd": "gasp"}}}},
    "squeak": {"sfx": "clarence_squeak", "pan": "hush"},
    "pin": {"sfx": "ui_tick"},
    "b_activity": {"by": {"field": "id", "map": {
      "pickles": {"voice": "vo_bellows_hum", "pan": "bellows"},
      "snack": {"sfx": "door_back", "vol_db": -6.0, "pan": "bellows"},
      "paper": {"sfx": "paper_rustle", "pan": "bellows"},
      "fire": {"sfx": "bellows_pump", "pan": "bellows"},
      "mirror": {"voice": "vo_bellows_hum", "pan": "bellows"},
      "phone": {"sfx": "phone_ring", "pan": "bellows"},
      "clock": {"sfx": "cupboard", "vol_db": -6.0, "pan": "bellows"},
      "hunt": {"voice": "vo_bellows_hmph", "pan": "bellows"}}}},
    "b_detour": {"voice": "vo_bellows_hmph", "pan": "bellows"},
    "entry_warning": [{"sfx": "door_jiggle", "pan": "source"},
      {"crowd": "behind_you", "delay_s": 0.3, "when": "hush_exposed"}],
    "doorway_pause": {"voice": "vo_bellows_ahem", "pan": "bellows"},
    "specs": {"by": {"field": "on", "map": {"true": {"sfx": "specs_tink", "pan": "bellows"}}}},
    "ear_pip": {"voice": "vo_bellows_huh", "pan": "bellows"},
    "squeak_bit": {"sting": "bit", "delay_s": 0.6},
    "head_turn": {"voice": "vo_bellows_huh", "pan": "bellows"},
    "lure": {"voice": "vo_bellows_huh", "pan": "bellows"},
    "lure_fatigue": {"voice": "vo_bellows_pipe_down", "pan": "bellows"},
    "spot_start": [{"sting": "spot"}, {"music": "suspense"}, {"crowd": "gasp", "delay_s": 0.15}],
    "near_miss": [{"sting": "near_miss"}, {"crowd": "relief", "delay_s": 0.2}, {"music": "sneak"}],
    "spotted": [{"sting": "alert"}, {"voice": "vo_bellows_wha", "delay_s": 0.1, "pan": "bellows"}],
    "chase_start": {"music": "chase"},
    "wheeze": {"voice": "vo_bellows_wheeze", "pan": "bellows"},
    "door_slam": [{"sfx": "door_slam", "pan": "source"}, {"crowd": "t1", "delay_s": 0.3}],
    "chase_end": {"music": "sneak"},
    "search": {"voice": "vo_bellows_hmph", "pan": "bellows"},
    "bump": {"by": {"field": "first", "map": {
      "true": [{"voice": "vo_bellows_pardon", "pan": "bellows"}, {"crowd": "t1", "delay_s": 0.5}]},
      "default": {"voice": "vo_bellows_huh", "pan": "bellows"}}},
    "face_to_face": {"crowd": "gasp"},
    "caught": [{"sting": "caught"}, {"crowd": "aww", "delay_s": 0.25}],
    "busted_cam": {"sfx": "record_scratch"},
    "lecture": {"by": {"field": "variant", "map": {
      "0": {"voice": "vo_bellows_lecture_a"}, "1": {"voice": "vo_bellows_lecture_b"},
      "2": {"voice": "vo_bellows_lecture_c"}}, "default": {"voice": "vo_bellows_lecture"}}},
    "doorstep": [{"sfx": "door_front"}, {"sfx": "knocker_bonk", "delay_s": 0.25}],
    "tomato": {"sfx": "tomato_splat", "pan": "hush"},
    "hook": [{"sfx": "zip"}, {"crowd": "aww", "delay_s": 0.2}],
    "knock_on": {"sting": "combo"},
    "fizzle": [{"sting": "fizzle"}, {"voice": "vo_bellows_hmph", "delay_s": 0.3, "pan": "bellows"},
      {"crowd": "aww", "delay_s": 0.5}],
    "combo": [{"sting": "combo"}, {"crowd": "t3", "delay_s": 0.2}],
    "temper_tier": {"by": {"field": "tier", "map": {
      "2": {"voice": "vo_bellows_grr", "pan": "bellows"},
      "3": [{"sfx": "specs_tink", "pan": "bellows"}, {"voice": "vo_bellows_grr", "delay_s": 0.15, "pan": "bellows"}]}}},
    "running_gag": [{"chain": "link"}, {"by": {"field": "link", "map": {
      "2": {"sting": "link2"}, "3": {"sting": "link3"}, "4": {"sting": "link3"}}, "default": {"sting": "link3"}}}],
    "running_gag_end": {"chain": 0},
    "meltdown_start": [{"sting": "meltdown"}, {"chain": 4}, {"crowd": "chant", "delay_s": 0.8}],
    "meltdown_stomp": {"sfx": "stomp_quake", "pan": "bellows"},
    "exhausted": {"voice": "vo_bellows_wheeze", "pan": "bellows"},
    "mirror_round": {"by": {"field": "round", "map": {
      "1": {"voice": "vo_bellows_hum", "pan": "bellows"}, "2": {"voice": "vo_bellows_ooh", "pan": "bellows"},
      "3": [{"sfx": "specs_tink", "pan": "bellows"}, {"crowd": "gasp", "delay_s": 0.1}]}}},
    "wink": {"sfx": "boing_small", "pan": "hush"},
    "bonus": {"sfx": "stamp_thunk"},
    "line_done": {"sfx": "stamp_thunk", "vol_db": -3.0},
    "big_number_unsealed": {"sting": "drumroll"},
    "all_lines_done": {"crowd": "bow_chant", "delay_s": 0.5},
    "star": {"sting": "new"},
    "director_cue": {"by": {"field": "id", "map": {
      "laugh_vase": [{"sfx": "vase_smash", "pan": "source"}, {"crowd": "t0", "delay_s": 0.25}],
      "laugh_doorframe": {"crowd": "t0", "delay_s": 0.2},
      "laugh_relief": {"crowd": "relief"},
      "laugh_picture": [{"sfx": "picture_fall", "pan": "source"}, {"crowd": "t0", "delay_s": 0.28}],
      "figgis_psst": {"sfx": "figgis_psst"},
      "sparkle_lever": {"sfx": "sparkle", "pan": "source"}}}},
    "safety_net": {"by": {"field": "on", "map": {"true": {"sfx": "whoosh", "vol_db": -6.0}}}},
    "figgis_hook": [{"sfx": "zip"}, {"crowd": "t1", "delay_s": 0.3}],
    "night_end": [{"sfx": "curtain_fall"}, {"crowd": "cheer", "delay_s": 0.4}, {"sfx": "roses_thrown", "delay_s": 1.0},
      {"music": "results", "delay_s": 1.6}],
    "cmd_queued": {"sfx": "ui_queued", "pan": "center"},
    "cmd_rejected": {"sfx": "ui_nuh_uh", "pan": "center"}
  },
  "pranks": {
    "kettle_drum": {"fire": {"sfx": "kettle_melody", "pan": "source"}},
    "tap_dance": {"fire": {"sfx": "spray_blast", "pan": "source"}},
    "in_a_pickle": {"fire": {"sfx": "jar_strain", "pan": "source"}},
    "cold_open": {"fire": {"sfx": "door_back", "vol_db": -4.0, "pan": "source"}},
    "allegro_go_go": {"fire": {"sfx": "gramophone_speedup", "pan": "source"}},
    "lift_off": {"fire": {"sfx": "recliner_twang", "pan": "source"}},
    "eye_popping_news": {"fire": {"sfx": "paper_rustle", "pan": "source"}},
    "something_fishy": {"fire": {"sfx": "phone_ring", "pan": "source"}},
    "times_up": {"fire": {"sfx": "clock_chimes", "pan": "source"}}
  },
  "archetypes": {
    "strain_slip": {"ooh": true},
    "avalanche_helmet": {"ooh": true},
    "launch_ceiling": {"ooh": true},
    "fish_slap": {"ooh": true},
    "jackhammer_cling": {"ooh": true}
  },
  "squeak_bits": {},
  "laugh_tiers": {
    "t1_max": 120,
    "t2_max": 240,
    "t3_link": 2,
    "t4_link": 3,
    "t4_on": ["meltdown_start", "signature"],
    "kinds": {"bit": "t1", "combo": "t3", "panto_bit": "t3", "meltdown": "t4", "rig": "t0"},
    "names": {"titter": "t0", "chuckle": "t1", "laugh": "t2", "big": "t3", "roar": "t4"},
    "hold_delay_s": 0.15,
    "duck_under_voice_db": -6.0
  },
  "music": {
    "states": ["curtain", "sneak", "suspense", "chase", "results", "silence"],
    "suspense_eta_s": 2.0,
    "chain_max": 4,
    "meltdown_section": 4,
    "curtain_up": "curtain",
    "after_curtain": "sneak"
  }
}
