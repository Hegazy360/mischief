; Engine configuration file.
; Mischief Next Door — Godot 4.7 project (landscape). See ../CLAUDE.md and ../docs/.

config_version=5

[application]

config/name="Mischief Next Door"
config/description="A silent mime pranks the loudest man alive: sneak, rig, freeze in plain sight."
run/main_scene="res://view3d/probe/PerfProbe3D.tscn"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.12, 0.1, 0.18, 1)
config/quit_on_go_back=false
run/max_fps=60

[autoload]

Settings="*res://autoload/settings.gd"
Save="*res://autoload/save.gd"
Haptics="*res://autoload/haptics.gd"
Content="*res://autoload/content.gd"
Audio="*res://autoload/audio.gd"
Router="*res://autoload/router.gd"
DevShot="*res://autoload/dev_shot.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1200
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/ios/hide_home_indicator=true
window/ios/suppress_ui_gesture=true
window/frame_pacing/android/swappy_mode=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.12, 0.1, 0.18, 1)

[shader_globals]

; R3D index §7.6 / ruling R8: every mnd_* global the 3D shaders read (game/art3d/shaders/), registered here so a
; `global uniform` compiles from a fresh process; StageLighting3D only sets values at runtime. New globals: ask the
; orchestrator (the owner of this file). mnd_key_dir = toward the key = -normalize(travel (0.45, -0.75, -0.48)).

mnd_key_dir={
"type": "vec3",
"value": Vector3(-0.451039, 0.751731, 0.481108)
}
mnd_key_color={
"type": "color",
"value": Color(1, 0.956863, 0.878431, 1)
}
mnd_key_lit={
"type": "float",
"value": 0.28
}
mnd_key_top={
"type": "float",
"value": 0.08
}
mnd_fill={
"type": "float",
"value": 0.66
}
mnd_fill_color={
"type": "color",
"value": Color(0.658824, 0.643137, 0.682353, 1)
}
mnd_band_soft={
"type": "float",
"value": 0.08
}
mnd_rim_color={
"type": "color",
"value": Color(0.74902, 0.878431, 1, 1)
}
mnd_rim_power={
"type": "float",
"value": 2.5
}
mnd_foot_strength={
"type": "float",
"value": 0.12
}
mnd_foot_fade_m={
"type": "float",
"value": 1.2
}
mnd_lip_z={
"type": "float",
"value": 0.25
}
mnd_outline_scale={
"type": "float",
"value": 1.0
}
mnd_shadow_tint={
"type": "color",
"value": Color(0.72549, 0.639216, 0.878431, 1)
}
mnd_bounce={
"type": "float",
"value": 0.14
}
mnd_sheen={
"type": "float",
"value": 0.1
}

[editor_plugins]

enabled=PackedStringArray("res://addons/mnd_export/plugin.cfg")
