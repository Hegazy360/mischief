## Index of an ease name (unknown names fall back to linear = 0).
static func id_of(ease_name: String) -> int:
	var i := IDS.find(ease_name)
	return i if i >= 0 else 0


## Eased per-mille value for per-mille progress `pm` (clamped to 0..1000).
static func eval_pm(ease_id: int, pm: int) -> int:
	var tab: Array = TABLE[ease_id] if ease_id >= 0 and ease_id < TABLE.size() else TABLE[0]
	if pm <= 0:
		return int(tab[0])
	if pm >= 1000:
		return int(tab[SAMPLES])
	var pos := pm * SAMPLES
	var i := Fx.div(pos, 1000)
	var rem := pos - i * 1000
	var a: int = tab[i]
	var b: int = tab[i + 1]
	return a + Fx.div((b - a) * rem, 1000)
