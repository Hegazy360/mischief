## s2-anim-bellows Phase G: Bellows' Gate-0 clip set (`data/anim/bellows/`, generated by
## tools/art/bellows/clips_spec.py). Every Phase-G clip exists, loads and lints STRICT clean (A01–A29), has
## its expected length (reactions.json frames, SimOneshots / clip_rules, micro-gag `len_f` ± 12 f, loops where
## the map loops them) — cross-checked against `SliceClips.build()` (s2-view, ruling L14) for every Phase-G clip
## the manifest lists; `knock_on` is unchanged; the sounds are s2-sound's clip-event rows; `map.json` uses only
## schema keys and every clip it names exists; the sneeze swaps the stool decor for its own prop and back.
## Phase M widens PHASE_G to every Bellows clip of the manifest.
extends TestBase

const MAP := "res://data/anim/bellows/map.json"
const REACTIONS := "res://data/reactions.json"
const PRANKS := "res://data/pranks.json"
const ACTIVITIES := "res://data/activities.json"
const CLIP_EVENTS := "res://data/audio/clip_events.json"
const SFX_MAP := "res://audio/sfx_map.json"
const HOUSE := "res://data/house/house.json"
const SNEEZE := "bellows/rx_sneeze_blast_a"

## The Phase-G set → expected length: > 0 exact frames, -1 = a loop of any length, -3 = a micro-gag (`len_f` ± 12).
const PHASE_G := {
	"bellows/loco_idle": -1, "bellows/loco_strut": -1, "bellows/loco_turn": 6, "bellows/loco_blind_shuffle": -1,
	"bellows/act_warmup": -1, "bellows/act_tea": -1, "bellows/rx_sneeze_blast_a": 165,
	"bellows/cue_doorframe_bonk": 36, "bellows/st_bonk": 60,
	"bellows/mg_admire_reflection_horn": -3, "bellows/mg_trill": -3, "bellows/mg_conduct_air": -3,
	"bellows/mg_hum": -3, "bellows/mg_admire_in_kettle": -3, "bellows/mg_pinkie_up": -3}
const LOOPS: Array[String] = ["bellows/loco_idle", "bellows/loco_strut", "bellows/loco_blind_shuffle",
	"bellows/act_warmup", "bellows/act_tea"]
const OVERLAYS: Array[String] = ["bellows/cue_doorframe_bonk", "bellows/mg_admire_reflection_horn", "bellows/mg_trill",
	"bellows/mg_conduct_air", "bellows/mg_hum", "bellows/mg_admire_in_kettle", "bellows/mg_pinkie_up"]


func _clip(id: String) -> ClipDef:
	ClipLib.invalidate(id)
	return ClipLib.get_clip(id)


func _dict(path: String) -> Dictionary:
	var d: Variant = load_json(path)
	return d if d is Dictionary else {}


func _events_of(c: ClipDef, type_filter: Array) -> Array:
	var out: Array = []
	for e: Dictionary in c.events:
		if type_filter.is_empty() or type_filter.has(String(e.get("type", ""))):
			out.append(e)
	return out


func test_every_phase_g_clip_exists_and_lints_strict_clean() -> void:
	AnimLint.reset_caches()
	for id: String in PHASE_G:
		var c := _clip(id)
		assert_true(c != null, "%s exists" % id)
		if c == null:
			continue
		assert_eq(c.errors, PackedStringArray(), "%s loads without errors" % id)
		var found := AnimLint.make_strict(AnimLint.lint_clip(c))
		var lines := PackedStringArray()
		for f: Dictionary in found:
			lines.append(AnimLint.format(f))
		assert_eq(found.size(), 0, "%s lints strict clean: %s" % [id, "; ".join(lines)])


func test_lengths_loops_and_layers() -> void:
	var mg_len := {}
	var acts := _dict(ACTIVITIES)
	for aid: String in acts.get("activities", {}):
		for g: Dictionary in (acts["activities"][aid] as Dictionary).get("micro_gags", []):
			mg_len["bellows/mg_" + String(g.get("id", ""))] = int(g.get("len_f", 0))
	for id: String in PHASE_G:
		var c := _clip(id)
		if c == null:
			continue
		var want := int(PHASE_G[id])
		if want > 0:
			assert_eq(c.length, want, "%s lasts %d f" % [id, want])
		elif want == -3:
			assert_has(mg_len, id, "%s is a micro-gag of activities.json" % id)
			assert_between(c.length, int(mg_len.get(id, 0)) - 12, int(mg_len.get(id, 0)) + 12, "%s ≈ len_f" % id)
		assert_eq(c.loop, LOOPS.has(id), "%s loop flag" % id)
		if OVERLAYS.has(id):
			assert_eq(c.layer, ClipDef.LAYER_OVERLAY, "%s is an overlay" % id)
			assert_eq(String(c.mask_spec), "upper", "%s masks the upper body" % id)
			assert_eq(c.mask_src, ClipDef.MASK_RIG, "%s uses the rig's mask" % id)
		else:
			assert_eq(c.layer, ClipDef.LAYER_BASE, "%s is a base clip" % id)


func test_the_manifest_agrees() -> void:
	var rows: Array[Dictionary] = SliceClips.build()
	if rows.is_empty():
		skip("SliceClips.build() returned no rows")
		return
	var by := {}
	for r: Dictionary in rows:
		by[String(r.get("clip", ""))] = r
	var checked := 0
	for id: String in PHASE_G:
		if not by.has(id):
			continue
		var r: Dictionary = by[id]
		var c := _clip(id)
		if c == null:
			continue
		checked += 1
		var ef := int(r.get("expect_f", -1))
		if ef >= 0 and not (c.loop and bool(r.get("loop_ok", false))):
			assert_le(absi(c.length - ef), int(r.get("tol_f", 0)), "%s: %d f vs the manifest's %d ± %d" % [id, c.length, ef, int(r.get("tol_f", 0))])
	assert_ge(checked, 12, "the manifest lists the Phase-G clips")


func test_the_sneeze_matches_reactions_json() -> void:
	var rx: Dictionary = (_dict(REACTIONS).get("archetypes", {}) as Dictionary).get("sneeze_blast_a", {})
	var c := _clip(SNEEZE)
	if c == null:
		fail("the sneeze clip is missing")
		return
	var marks: Dictionary = rx.get("marks", {})
	assert_eq(c.length, int(rx.get("frames", 0)))
	assert_eq(c.beat("anticipation").x, int(marks.get("antic", -1)))
	assert_eq(c.beat("accent").x, int(marks.get("accent", -1)))
	assert_eq(c.beat("hold"), Vector2i(int(marks["hold"][0]), int(marks["hold"][1])))
	assert_eq(c.beat("settle").y, int(marks.get("release", -1)))
	# knock_on is frozen: it must equal pranks.json knock_on.frame (TAP DANCE's HOT & COLD at 112)
	var pr: Dictionary = (_dict(PRANKS).get("pranks", {}) as Dictionary).get("achoo_ria", {})
	assert_eq(int(marks.get("knock_on", -1)), 112, "knock_on unchanged")
	assert_eq(int((pr.get("knock_on", {}) as Dictionary).get("frame", -1)), int(marks.get("knock_on", -2)))
	assert_eq(c.mark("knock_on"), 112, "the clip marks the sink contact")
	assert_eq(c.mark("accent"), int(marks.get("accent", -1)))
	for bn: String in ["ah", "ahh", "ahhh", "false_stop", "choo", "in_the_sink", "dazed"]:
		var b: Array = (rx.get("beats", {}) as Dictionary).get(bn, [])
		assert_eq(c.beat(bn), Vector2i(int(b[0]), int(b[1])), "beat %s" % bn)
	assert_eq(c.time_jitter, 0.0)
	var tr: Dictionary = rx.get("travel", {})
	assert_eq(String(tr.get("ease", "")), "linear", "the flight arrives at full speed (a crash, not a glide)")
	# the accent is a pose pop with the CHOO on it; the face swaps on keys
	var k := c.key_at(int(marks["accent"]))
	assert_ge(k, 0, "a key on the accent")
	assert_eq(c.key_ease[k], RigEase.id("pop"), "the accent pops")


func test_the_stool_swaps_with_the_decor_invisibly() -> void:
	var c := _clip(SNEEZE)
	if c == null:
		return
	var seq: Array = []
	for e: Dictionary in c.events:
		var t := String(e.get("type", ""))
		if t == "decor" and String(e.get("id", "")) == "kitchen_stool":
			seq.append([int(e["f"]), "decor", bool(e.get("visible", true))])
		elif t == "prop" and String(e.get("prop", "")) == "stool":
			seq.append([int(e["f"]), String(e.get("op", "")), String(e.get("state", ""))])
	# f0: the prop shows and the decor hides together; f1 the prop is put down where it stands (the decor's pixels)
	assert_true(seq.has([0, "decor", false]), "the decor hides on f0")
	assert_true(seq.has([0, "state", "under"]), "the prop shows on f0")
	assert_true(seq.has([1, "detach", ""]), "the prop is put down on f1")
	var launch := -1
	var back := -1
	var hide := -1
	for s: Array in seq:
		if s[1] == "launch":
			launch = s[0]
		if s[1] == "decor" and s[2] == true:
			back = s[0]
		if s[1] == "hide":
			hide = s[0]
	assert_gt(launch, int(c.mark("knock_on")), "the stool hops home only once his x has stopped (after the knock-on frame)")
	assert_eq(back, hide, "the decor returns on the frame the prop hides (never two stools, never none)")
	assert_lt(back, c.length, "…before the reaction ends")
	# the hop lands on the decor's pixels: the clip records the solve, PropSim agrees
	var hop: Dictionary = c.raw.get("stool_hop", {})
	assert_false(hop.is_empty(), "stool_hop solve recorded")
	var rig := RigDef.for_id("bellows")
	var pr: RigDef.RigProp = rig.props[rig.prop_index["stool"]]
	var sz: Vector2 = pr.state_sizes[pr.default_state]
	var radius := maxf(sz.x, sz.y) * 0.5
	var st: Array = hop.get("start", [0, 0, 0])
	var v: Array = hop.get("vel", [0, 0])
	var rest := PropSim.ballistic(Vector2(st[0], st[1]), Vector2(v[0], v[1]), float(st[2]), float(hop.get("spin", 0)), 5.0, -radius)
	assert_almost_eq(rest.x, float(hop.get("home_char_x", 0)), 1.0, "rests at home x")
	assert_almost_eq(fposmod(rest.z + 180.0, 360.0) - 180.0, 0.0, 1.0, "rests upright")
	assert_le(int(hop.get("rest_f", 999)), back, "has come to rest before the decor returns")
	# the house decor stool's pivot = the rest pivot (0.5 px: PropSim's radius rounding)
	var house := _dict(HOUSE)
	for d: Dictionary in house.get("decor", []):
		if String(d.get("id", "")) == "kitchen_stool":
			assert_almost_eq(float(d["pos"][1]) + pr.pivot.y, -radius, 1.0, "the decor's pivot height = the prop's rest height")
			assert_almost_eq(float(d["pos"][0]) + float(d["size"][0]) * 0.5, 3000.0, 0.5, "the decor stool stands at st_tea (x 3000)")


func test_the_sip_hands_over_to_the_sneeze() -> void:
	## act_tea at 7.0 s (the ACHOO-RIA! trigger) shows exactly the sneeze's first pose: the frame-locked reaction
	## starts with blend_in 0, so any difference would pop.
	var tea := _clip("bellows/act_tea")
	var rx := _clip(SNEEZE)
	if tea == null or rx == null:
		return
	var pr: Dictionary = (_dict(PRANKS).get("pranks", {}) as Dictionary).get("achoo_ria", {})
	var mark_f := roundi(float((pr.get("trigger", {}) as Dictionary).get("mark_s", 7.0)) * 60.0)
	var a := tea.rig.rest.duplicate()
	var b := rx.rig.rest.duplicate()
	RigSampler.sample(tea, float(mark_f % tea.length), a)
	RigSampler.sample(rx, 0.0, b)
	var worst := 0.0
	for i in a.size():
		worst = maxf(worst, absf(a[i] - b[i]))
	assert_lt(worst, 0.51, "act_tea f%d == rx_sneeze_blast_a f0 (max channel diff %.2f)" % [mark_f % tea.length, worst])
	assert_eq(rx.key_pose_name[0], "b_stool_ahh")


func test_sounds_are_the_clip_event_rows() -> void:
	var table: Dictionary = _dict(CLIP_EVENTS).get("clips", {})
	var sm := _dict(SFX_MAP)
	var known := {}
	for sec_name: String in ["files", "banks", "aliases", "cycles", "sequences"]:
		var sec: Variant = sm.get(sec_name, {})
		if sec is Dictionary:
			for i: Variant in sec:
				known[String(i)] = true
	for id: String in PHASE_G:
		var c := _clip(id)
		if c == null:
			continue
		for e: Dictionary in _events_of(c, ["sfx", "voice"]):
			if not known.is_empty():
				assert_has(known, String(e.get("id", "")), "%s f%d: '%s' is an sfx_map id" % [id, int(e["f"]), e.get("id", "")])
		if not table.has(id):
			continue
		for row: Dictionary in (table[id] as Dictionary).get("events", []):
			var hit := false
			for e2: Dictionary in _events_of(c, [String(row.get("type", ""))]):
				if String(e2.get("id", "")) == String(row.get("id", "")) and absi(int(e2["f"]) - int(row["f"])) <= 1:
					hit = true
			assert_true(hit, "%s carries %s '%s' at f%d ± 1" % [id, row.get("type", ""), row.get("id", ""), int(row["f"])])
		for e3: Dictionary in c.events:
			assert_ne(String(e3.get("type", "")), "laugh", "%s: laughs are event-level (L12)" % id)


func test_map_uses_the_schema_and_resolves() -> void:
	var m := _dict(MAP)
	assert_eq(String(m.get("rig", "")), "bellows")
	for k: String in m:
		if ClipMap.META_KEYS.has(k):
			continue
		var fam := k
		if k.contains(":"):
			fam = k.get_slice(":", 0) + ":*"
		assert_true(ClipMap.SCHEMA_KEYS.has(fam) or ClipMap.SCHEMA_KEYS.has(k), "map key %s is in the s2-view schema" % k)
		var e: Variant = m[k]
		var clip := ""
		if e is String:
			clip = String(e)
		elif e is Dictionary:
			clip = String((e as Dictionary).get("clip", ""))
		if clip == "" or clip == ClipMap.FROM_SIM:
			continue
		assert_true(_clip(clip) != null, "%s → %s exists" % [k, clip])
	var walk: Dictionary = m.get("walk", {})
	assert_eq(int(walk.get("speed_px_s", 0)), 240, "strut speed (GDD §4.1)")
	var strut := _clip("bellows/loco_strut")
	if strut != null:
		assert_almost_eq(float(walk.get("stride_px", 0)), strut.stride_px, 0.01, "map stride = clip stride")
		# lead ruling L3: 15–16 f per step at 240 px/s
		var f_per_step := strut.length / 2.0
		assert_between(f_per_step, 15.0, 16.0, "L3 cadence")
		assert_almost_eq(strut.stride_px / (strut.length / 60.0), 240.0, 0.5, "natural speed 240 px/s")
	for k2: String in ["idle", "walk", "walk@blind", "turn", "activity:warmup", "activity:tea", "oneshot:stun",
			"cue:laugh_doorframe", "reaction_fallback", "mg:pinkie_up"]:
		assert_has(m, k2, "map key " + k2)
