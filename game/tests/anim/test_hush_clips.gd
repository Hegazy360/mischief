## s2-anim-hush Phase G: Hush's Gate-0 clip set (`data/anim/hush/`, generated by tools/art/hush/clips_hush.py).
## Every clip exists, loads and lints STRICT with 0 findings; lengths are the sim's (SimConst, the Prologue's
## `hush.enter.busy_s`, SliceClips' expected lengths where it lists the clip); walks plant their feet at the sim
## speeds; `map.json` uses only schema keys and every clip it names resolves; sounds are sfx_map ids at the
## clip_events.md frames; flavour clips start with Clarence home and never leave the floor.
## SliceClips (s2-view, being built in the same batch) is a soft hook: the manifest test skips until it exists.
extends TestBase

const MAP := "res://data/anim/hush/map.json"
const SFX_MAP := "res://audio/sfx_map.json"
const SLICE_CLIPS := "res://view/world/slice_clips.gd"
const P00 := "res://data/episodes/p00_curtain_up.json"

## The Phase-G set and its exact lengths (-1 = the clip's own length; the map loops it or plays it once).
const PHASE_G := {
	"hush/loco_idle": -1, "hush/idle_fidget_look": -1, "hush/idle_fidget_proud": -1,
	"hush/idle_fidget_clarence": -1, "hush/loco_walk": -1, "hush/loco_run": -1, "hush/loco_turn": 6,
	"hush/act_climb_in": -2, "hush/act_tinker_q": SimConst.PREP_Q, "hush/act_tinker_s": SimConst.PREP_S,
	"hush/act_tinker_b": SimConst.PREP_B, "hush/act_snicker": -1, "hush/act_dive": SimConst.DIVE_TICKS,
	"hush/act_pop": SimConst.POP_TICKS, "hush/act_squeak": SimConst.SQUEAK_ARM_TICKS,
	"hush/freeze_1": -1, "hush/freeze_2": -1, "hush/freeze_3": -1, "hush/freeze_4": -1}
const LOOPS: Array[String] = ["hush/loco_idle", "hush/loco_walk", "hush/loco_run", "hush/act_tinker_q",
	"hush/act_tinker_s", "hush/act_tinker_b"]
const FLAVOUR: Array[String] = ["hush/idle_fidget_look", "hush/idle_fidget_proud", "hush/idle_fidget_clarence",
	"hush/act_snicker"]
const TAKES: Array[String] = ["hush/act_snicker", "hush/act_dive", "hush/freeze_1", "hush/freeze_2",
	"hush/freeze_3", "hush/freeze_4"]
## docs/review/s2-sound/clip_events.md (Phase G): clip → [[frame, id], …].
const SOUNDS := {
	"hush/act_climb_in": [[0, "window_creak"], [18, "step_pizz_up"], [28, "step_pizz_up"], [38, "step_pizz_up"],
		[50, "step_pizz_up"]],
	"hush/act_tinker_q": [[6, "tinker"], [22, "tinker"], [38, "tinker"]],
	"hush/act_tinker_s": [[4, "tinker_frantic"], [48, "tinker_frantic"]],
	"hush/act_tinker_b": [[4, "tinker_frantic"], [48, "tinker_frantic"], [92, "tinker"], [118, "hush_phew"]],
	"hush/act_snicker": [[0, "hush_snicker"]], "hush/act_dive": [[0, "dive"]], "hush/act_pop": [[0, "pop_out"]],
	"hush/freeze_1": [[5, "freeze_clack"]], "hush/freeze_2": [[5, "freeze_clack"]],
	"hush/freeze_3": [[5, "freeze_clack"]], "hush/freeze_4": [[5, "freeze_clack"]],
	"hush/loco_walk": [[0, "step_pizz_up"], [10, "step_pizz_up"]], "hush/loco_run": [[0, "step_pizz_up"], [12, "step_pizz_up"]]}


func _clip(id: String) -> ClipDef:
	ClipLib.invalidate(id)
	return ClipLib.get_clip(id)


func _map() -> Dictionary:
	var d: Variant = load_json(MAP)
	return d if d is Dictionary else {}


func test_every_phase_g_clip_exists_and_lints_strict_clean() -> void:
	AnimLint.reset_caches()
	for id in PHASE_G:
		var c := _clip(String(id))
		assert_true(c != null, "%s exists" % id)
		if c == null:
			continue
		assert_eq(c.errors, PackedStringArray(), "%s loads without errors" % id)
		var found := AnimLint.make_strict(AnimLint.lint_clip(c))
		var lines := PackedStringArray()
		for f in found:
			lines.append(AnimLint.format(f))
		assert_eq(found.size(), 0, "%s lints strict clean: %s" % [id, "; ".join(lines)])


func test_lengths_match_the_sim() -> void:
	var enter_f := -1
	var ep: Variant = load_json(P00)
	if ep is Dictionary:
		var en: Dictionary = ((ep as Dictionary).get("hush", {}) as Dictionary).get("enter", {})
		enter_f = roundi(float(en.get("busy_s", 0.0)) * 60.0)
	assert_eq(enter_f, 60, "the Prologue climb-in busy time is 1.0 s")
	for id in PHASE_G:
		var c := _clip(String(id))
		if c == null:
			continue
		var want := int(PHASE_G[id])
		if want == -2:
			want = enter_f
		if want > 0:
			assert_eq(c.length, want, "%s lasts %d f" % [id, want])
		assert_eq(c.loop, LOOPS.has(String(id)), "%s loop flag" % id)


func test_walks_plant_their_feet_at_the_sim_speeds() -> void:
	var m := _map()
	for row in [["walk", "hush/loco_walk", SimConst.HUSH_TIPTOE, 10], ["run", "hush/loco_run", SimConst.HUSH_RUN, 12]]:
		var c := _clip(String(row[1]))
		if c == null:
			fail("%s missing" % row[1])
			continue
		var e: Dictionary = m.get(String(row[0]), {})
		assert_eq(String(e.get("clip", "")), String(row[1]), "map %s" % row[0])
		assert_almost_eq(float(e.get("speed_px_s", 0.0)), float(row[2]), 0.01, "map %s speed" % row[0])
		assert_almost_eq(float(e.get("stride_px", 0.0)), c.stride_px, 0.01, "map %s stride = the clip's" % row[0])
		# stride per loop / loop length = the sim speed (px per frame at 60 fps)
		assert_almost_eq(c.stride_px / float(c.length) * 60.0, float(row[2]), 0.5, "%s travels at the sim speed" % row[1])
		# one footfall sound per step: steps every 10 f (tiptoe) / 12 f (run)
		var steps := 0
		for ev in c.events:
			if String(ev.get("type", "")) == "sfx":
				assert_eq(int(ev["f"]) % int(row[3]), 0, "%s footfall on a step frame" % row[1])
				steps += 1
		assert_eq(steps, c.length / int(row[3]), "%s one footfall per step" % row[1])
		assert_true(c.plant, "%s uses the plant lock" % row[1])


func test_sounds_are_sfx_ids_on_the_clip_events_frames() -> void:
	var sm: Variant = load_json(SFX_MAP)
	assert_true(sm is Dictionary, "sfx_map parses")
	var ids := {}
	for k in ["files", "banks", "aliases", "cycles", "sequences"]:
		var sec: Variant = (sm as Dictionary).get(k, {}) if sm is Dictionary else {}
		if sec is Dictionary:
			for i in sec:
				ids[String(i)] = true
	for id in PHASE_G:
		var c := _clip(String(id))
		if c == null:
			continue
		for ev in c.events:
			var t := String(ev.get("type", ""))
			if t == "sfx" or t == "voice":
				assert_true(ids.has(String(ev.get("id", ""))), "%s sound '%s' is an sfx_map id" % [id, ev.get("id", "")])
	for id in SOUNDS:
		var c2 := _clip(String(id))
		if c2 == null:
			continue
		for want in SOUNDS[id]:
			var hit := false
			for ev in c2.events:
				if String(ev.get("type", "")) == "sfx" and int(ev["f"]) == int(want[0]) and String(ev.get("id", "")) == String(want[1]):
					hit = true
			assert_true(hit, "%s plays %s at f%d (clip_events.md)" % [id, want[1], want[0]])


func test_squeak_has_no_sound_and_moves_clarence() -> void:
	var c := _clip("hush/act_squeak")
	if c == null:
		fail("act_squeak missing")
		return
	var grip := -1
	var home := -1
	for ev in c.events:
		assert_ne(String(ev.get("type", "")), "sfx", "the squeak is event-level (a tap answers at once)")
		if String(ev.get("type", "")) == "prop" and String(ev.get("op", "")) == "attach":
			if String(ev.get("socket", "")) == "hand_r:grip":
				grip = int(ev["f"])
			elif String(ev.get("socket", "")) == "torso:braces" and int(ev["f"]) > 0:
				home = int(ev["f"])
	assert_between(grip, 0, 3, "Clarence in her fist within 3 f")
	assert_between(home, grip + 1, c.length, "and back in the braces before the arm ends")


func test_flavour_clips_start_with_clarence_home_and_stay_grounded() -> void:
	for id in FLAVOUR:
		var c := _clip(id)
		if c == null:
			fail("%s missing" % id)
			continue
		var home := false
		for ev in c.events:
			if int(ev["f"]) == 0 and String(ev.get("type", "")) == "prop" and String(ev.get("op", "")) == "attach" \
					and String(ev.get("socket", "")) == "torso:braces":
				home = true
		assert_true(home, "%s puts Clarence home on f0 (a cut on any frame never strands him)" % id)
		assert_true(c.plant, "%s is planted" % id)
		# never leaves the floor: every key has a foot on it (plant lock holds it between keys)
		for k in c.key_f.size():
			var on := 0
			for j in c.rig.feet.size():
				on += c.plant_on[k * c.rig.feet.size() + j]
			assert_gt(on, 0, "%s key f%d keeps a foot on the floor" % [id, c.key_f[k]])
		assert_le(c.key_f[mini(2, c.key_f.size() - 1)], 20, "%s: the joke lands in the first 20 f" % id)


func test_takes_have_beats_with_a_short_accent() -> void:
	for id in TAKES:
		var c := _clip(id)
		if c == null:
			fail("%s missing" % id)
			continue
		var acc := c.beat("accent")
		assert_true(acc.x >= 0, "%s has an accent beat" % id)
		assert_le(acc.y - acc.x, 4, "%s accent ≤ 4 f" % id)
		assert_true(c.beat("anticipation").x >= 0, "%s has an anticipation" % id)
		assert_true(c.beat("hold").x >= 0, "%s has a hold" % id)
	var sn := _clip("hush/act_snicker")
	if sn != null:
		# GDD 9.3: shoulders at 8 Hz for 40 f — keys ≤ 4 f apart through the hold
		var h := sn.beat("hold")
		assert_ge(h.y - h.x, 36, "the snicker shakes for ~40 f")
		var prev := -1
		for f in sn.key_f:
			if f >= h.x and f <= h.y:
				if prev >= 0:
					assert_le(f - prev, 4, "snicker shake keys every ≤ 4 f (8 Hz)")
				prev = f


func test_map_keys_are_schema_keys_and_resolve() -> void:
	var m := _map()
	assert_false(m.is_empty(), "map.json parses")
	for k in m:
		var key := String(k)
		if ClipMap.META_KEYS.has(key):
			continue
		assert_true(_schema_key(key), "map key %s is in the s2-view schema" % key)
		for cid in ClipMap.clips_of(m[k]):
			assert_true(_clip(cid) != null, "map %s → %s exists" % [key, cid])
	for need in ["idle", "idle_fidgets", "walk", "run", "turn", "rigging@q", "rigging@s", "rigging@b",
			"state:diving", "state:popping", "state:squeaking", "freeze", "oneshot:enter", "flavour:snicker"]:
		assert_has(m, need, "map has %s" % need)
	assert_eq(m.get("state:hidden", null), "", "hidden = not drawn")
	assert_eq(ClipMap.clips_of(m.get("freeze", [])).size(), 4, "the 4 Phase-G statues")
	var fz: Variant = m.get("freeze", {})
	assert_true(fz is Dictionary and not bool((fz as Dictionary).get("loop", true)),
		"statues play once and hold (the pop must not repeat)")
	for key in ["rigging@q", "rigging@s", "rigging@b"]:
		assert_true(bool((m.get(key, {}) as Dictionary).get("loop", false)), "%s loops" % key)


func test_manifest_lengths_for_the_phase_g_set() -> void:
	if not ResourceLoader.exists(SLICE_CLIPS):
		skip("SliceClips (s2-view) not built yet")
		return
	var sc: Script = load(SLICE_CLIPS)
	var rows: Variant = sc.call("build", "")
	if not (rows is Array):
		skip("SliceClips.build() returned no rows")
		return
	var seen := 0
	for r in rows:
		var row: Dictionary = r
		var id := String(row.get("clip", ""))
		if not PHASE_G.has(id):
			continue
		seen += 1
		var c := _clip(id)
		assert_true(c != null, "manifest clip %s exists" % id)
		if c == null:
			continue
		var want := int(row.get("expect_f", -1))
		var tol := int(row.get("tol_f", 0))
		if want > 0 and not (c.loop and bool(row.get("loop_ok", false))):
			assert_between(c.length, want - tol, want + tol, "%s matches the manifest's %d f" % [id, want])
		var mx := int(row.get("max_f", 0))
		if mx > 0 and not c.loop:
			assert_le(c.length, mx, "%s ≤ the manifest's max %d f" % [id, mx])
		if c.loop:
			assert_true(bool(row.get("loop_ok", false)) or want < 0, "%s may loop" % id)
	assert_ge(seen, 15, "the manifest lists the Phase-G clips")


func _schema_key(key: String) -> bool:
	for s in ClipMap.SCHEMA_KEYS:
		if s.ends_with("*"):
			if key.begins_with(s.substr(0, s.length() - 1)):
				return true
		elif key == s:
			return true
	return false
